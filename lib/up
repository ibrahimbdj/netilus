#!/bin/bash

set -eo pipefail

shift_ip(){
    local ip="${2#*:}"

    if [ "${2%:*}" = "fnext" ]; then
        local a="${ip#*.}"
        local b="${a#*.}"
        a="${a%.*}"

        if [ "$b" = "255" ]; then
            if [ "$a" = "255" ]; then
                echo "Mate you won ! You reached the limit of available subnet in my little and poor utility"
                exit 1
            else
                a=$((a + 1))
                b="0"
            fi
        else
            b=$((b + 1))
        fi

        local new_ip_range="10.${a}.${b}"

        sed -i "s/fnext:.*/fnext:${new_ip_range}/" "$1"

    elif [ "${2%:*}" = "next" ]; then
        sed -i "/next:${ip}[[:space:]]*$/d" "$1"
    else
        echo "Mate check your network config file >:("
    fi
}

ip_gen(){
    local ip_line="$(tail -1 "$1")"

    local ip_range="${ip_line#*:}"

    local i="$2"

    while [ "$i" -gt "0" ]; do
        eval ip${i}="${ip_range%% *}.$i"
        i=$((i - 1))
    done

    shift_ip "$1" "$ip_line"
}

veth_name_gen(){
    local i=0

    while ip -n "$1" link show "${3:0:1}${1}-${2}-${i}" >/dev/null 2>&1; do
        i=$((i + 1))
    done

    veth_name="${3:0:1}${1}-${2}-${i}"
}

peer(){
    if [ ${#1} -gt 5 ] || [ ${#2} -gt 5 ]; then
        echo "For now, the maximum length for device names is 5 char, it will be increased"
        exit 1
    fi

    if [ "$1" = "$2" ]; then
        echo "Please dont use the same device names"
        exit 1
    fi

    if [ ! -e "/var/run/netns/$1" ]; then
        ip netns add "$1"
    fi

    if [ ! -e "/var/run/netns/$2" ]; then
        ip netns add "$2"
    fi

    veth_name_gen "$1" "$2" "peer"
    veth1=$veth_name
    veth2="b${2}-${1}-${veth1##*-}"

    local -A veth=(["$1"]="$veth1" ["$2"]="$veth2")

    ip link add "${veth["$1"]}" netns "$1" type veth peer name "${veth["$2"]}" netns "$2"
    
    for ns in "$1" "$2"; do
        ip -n "$ns" link set ${veth["$ns"]} up
        ip -n "$ns" link set lo up
    done

    ip_gen "$3" "2"

    ip -n "$1" addr add "$ip1"/24 dev ${veth["$1"]}
    ip -n "$2" addr add "$ip2"/24 dev ${veth["$2"]}
}

bridge(){
    echo "not implemented yet"
}

declare -A cmd=(["peer"]="peer" ["bridge"]="bridge")

network_conf="${0%/*/*}/config/network.cfg"

while read -r line; do
    if [ ! -z "${cmd[${line%% *}]}" ]; then
        $line "$network_conf"
    fi
done < "$1"

if [ ! -z "${cmd[${line%% *}]}" ]; then
    $line $network_conf
fi