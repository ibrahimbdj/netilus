#!/bin/bash

set -eo pipefail

shift_ip(){
    local a="${next_subnet#*.}"
    local b="${a#*.}"
    a="${a%.*}"

    if [ "$b" = "255" ]; then
        if [ "$a" = "255" ]; then
            echo "Mate you won ! You reached the limit of available next_subnet in my little and poor utility"
            exit 1
        else
            a=$((a + 1))
            b="0"
        fi
    else
        b=$((b + 1))
    fi

    next_subnet="10.${a}.${b}"
}

ip_gen(){
   local i=0

    while [ "$i" -lt "$2" ]; do
        i=$((i + 1))
        ip_followup[$1]=$((ip_followup[$1] + 1))

        if [ ${ip_followup[$1]} -gt 254 ]; then
            echo "Limit of ip reached in subnet ${1}.0/24"
            exit 1
        fi

        ip_tab[i]="${1}.${ip_followup[$1]}"
    done
}

check_name(){
    local c='[a-zA-Z0-9]'
    local d=$c$c
    local e=$d$d
    local f=$e$e

    case "$1" in
        $c | $d | $d$c | $e | $e$c | $e$d | $e$d$c | $f | $f$c | $f$d |$f$d$c | $f$e);;
        *)
        echo "Invalid name: $1"
        exit 1
        ;;
    esac
}

veth_gen(){
    if [ ${#1} -gt 12 ] || [ ${#2} -gt 12 ]; then
        echo "Error: maximum object name is 12 !"
        exit 1
    fi

    local i=0

    while ip -n "$1" link show "${2}-${i}" >/dev/null 2>&1; do
        i=$((i + 1))
    done

    veth1="${2}-${i}"
    veth2="${1}-${i}"

    if [ ${#veth1} -gt 15 ] || [ ${#veth2} -gt 15 ]; then
        echo "Error: Maximum veth name length reached, format: <object1_name>-<nth veth to the ns>"
        exit 1
    fi

    ip link add "$veth1" netns "$1" type veth peer name "$veth2" netns "$2"
}

check_ns(){
    check_name "$1"
    check_name "$2"

    if [ "$1" = "$2" ]; then
        echo "Peer error: please dont use the same args"
        exit 1
    fi

    if [ ! -e "/var/run/netns/$1" ]; then
        ip netns add "$1"
    fi

    if [ ! -e "/var/run/netns/$2" ]; then
        ip netns add "$2"
    fi
}

toHost(){
    ip -n "$1" link set "$2" up
    ip -n "$1" addr add "$3"/24 dev "$2"
    ip -n "$1" link set lo up
}

toBridge(){
    if ! ip -n "$1" link show "$1" >/dev/null 2>&1; then
        ip -n "$1" link add "$1" type bridge
        ip -n "$1" link set "$1" up
    fi

    ip -n "$1" link set "$2" up
    ip -n "$1" link set lo up

    ip -n "$1" link set "$2" master "$1"
}

peer(){
    check_ns "$1" "$2"

    ip_gen "$next_subnet" "2"
    shift_ip

    veth_gen "$1" "$2"

    toHost "$1" "$veth1" "${ip_tab[1]}"
    toHost "$2" "$veth2" "${ip_tab[2]}"
}

bridge(){

    check_ns "$1" "$2"
    veth_gen "$1" "$2"

    case "$3" in
        "-b")
            if [ "${bridge_ip[$1]}" = "${bridge_ip[$2]}" ]; then
                if [ -z "${bridge_ip[$1]}" ]; then
                    bridge_ip[$1]="$next_subnet"
                    bridge_ip[$2]="$next_subnet"
                    shift_ip
                fi
            elif [ -z "${brige_ip[$1]}" ]; then
                bridge_ip[$1]="${bridge_ip[$2]}"
            elif  [ -z "${brige_ip[$2]}" ]; then
                bridge_ip[$2]="${bridge_ip[$1]}"
            else
                echo "If you want link 2 bridge, you need to be in those case:"
                echo "1) Only one of the two bridges already exist"
                echo "2) The two bridge does not exist yet"

                exit 1
            fi

            toBridge "$2" "$veth2"
        ;;
        *)
            if [ -z "${bridge_ip[$1]}" ]; then
                bridge_ip[$1]="$next_subnet"
                shift_ip
            fi

            ip_gen "${bridge_ip[$1]}" "1"
            toHost "$2" "$veth2" "${ip_tab[1]}"
        ;;
    esac

    toBridge "$1" "$veth1"
}

declare -A cmd=(["peer"]="peer" ["bridge"]="bridge")
declare -A bridge_ip
declare -A ip_followup
declare -a ip_tab

{
    read -r next_subnet
    ip_followup=(["$next_subnet"]="0")
    while read -r line; do
        if [ ! -z "$line" ] && [ ! -z "${cmd[${line%% *}]}" ]; then
            $line
        fi
    done
} < "$1"

if [ ! -z "$line" ] && [ ! -z "${cmd[${line%% *}]}" ]; then
    $line
fi