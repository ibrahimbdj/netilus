#!/bin/bash

set -eo pipefail

shift_ip(){
    local a="${next_subnet#*.}"
    local b="${a#*.}"
    a="${a%.*}"

    if [ "$b" = "255" ]; then
        if [ "$a" = "255" ]; then
            echo "Mate you won ! You reached the limit of available next_subnet in my little and poor utility"
            exit 1
        else
            a=$((a + 1))
            b="0"
        fi
    else
        b=$((b + 1))
    fi

    next_subnet="10.${a}.${b}"
}

ip_gen(){
   local i="$1"

    while [ "$i" -gt "0" ]; do
        eval ip${i}="${next_subnet}.$i"
        i=$((i - 1))
    done

    shift_ip
}

veth_name_gen(){
    local i=0

    while ip -n "$1" link show "${1}-${2}-${i}" >/dev/null 2>&1; do
        i=$((i + 1))
    done

    veth_name="${1}-${2}-${i}"
}

valid_name(){
    local c='[a-zA-Z0-9_-]'

    case "$1" in
        $c | $c$c | $c$c$c | $c$c$c$c | $c$c$c$c$c);;
        *)
        echo "Invalid name: $1"
        exit 1
        ;;
    esac
}

peer(){
    if [ ${#1} -gt 5 ] || [ ${#2} -gt 5 ]; then
        echo "For now, the maximum length for device names is 5 char, it will be increased"
        exit 1
    fi

    if [ "$1" = "$2" ]; then
        echo "Please dont use the same device names"
        exit 1
    fi

    valid_name "$1"
    valid_name "$2"

    if [ ! -e "/var/run/netns/$1" ]; then
        ip netns add "$1"
    fi

    if [ ! -e "/var/run/netns/$2" ]; then
        ip netns add "$2"
    fi

    veth_name_gen "$1" "$2" "peer"
    local veth1=$veth_name
    local veth2="${2}-${1}-${veth1##*-}"

    ip_gen "2"

    ip link add "$veth1" netns "$1" type veth peer name "$veth2" netns "$2"
    
    ip -n "$1" link set "$veth1" up
    ip -n "$1" addr add "$ip1"/24 dev "$veth1"
    ip -n "$1" link set lo up

    ip -n "$2" link set "$veth2" up
    ip -n "$2" addr add "$ip2"/24 dev "$veth2"
    ip -n "$2" link set lo up
}

bridge(){
    if [ ${#1} -gt 6 ]; then
        echo "Bridge name too long"
        exit 1
    fi

    if [ ip link show "$1" 2> /dev/null ]; then
        echo "Bridge \"${1}\" already exist"
        exit 1
    fi

    ip link add "$1" type bridge
    ip link set "$1" up

    valid_name "$1"

    ip_gen "$2"

    local i="$2"
    while [ $i -gt 0 ]; do
        ip netns add "$1$i"

        local veth1="${1}-${1}${i}"
        local veth2="${1}${i}-${1}"

        ip link add "$veth1" type veth peer name "$veth2" netns "$1$i"
        ip link set "$veth1" up
        ip -n "$1$i" link set "$veth2" up
        ip -n "$1$i" link set lo up
        eval ip -n "$1$i" addr add "\$ip${i}/24" dev "$veth2"
        ip link set "$veth1" master "$1"

        i=$((i - 1))
    done
}

declare -A cmd=(["peer"]="peer" ["bridge"]="bridge")

{
    read -r next_subnet
    while read -r line; do
        if [ ! -z "$line" ] && [ ! -z "${cmd[${line%% *}]}" ]; then
            $line
        fi
    done
} < "$1"

if [ ! -z "$line" ] && [ ! -z "${cmd[${line%% *}]}" ]; then
    $line
fi