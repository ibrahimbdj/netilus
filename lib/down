#!/bin/bash

set -eo pipefail

free(){
    
    if [ ! -e "/var/run/netns/$1" ]; then return 0; fi;

    if [ "$2" = "peer" ]; then
        
        local ip_tmp=$(ip -n "$1" -br -4 addr | grep "p$1")
        local ip_list=$( echo "$ip_tmp" | grep -Eo "([0-9]{1,3}\.){3}[0-9]{1,3}")
        local veth_list=$( echo "$ip_tmp" | grep -Eo "p$1-.{1,5}-[0-9]{1,2}")
        
        if [ -n "$(tail -c 1 $3)" ]; then
            printf '\n' >> "$3"
        fi

        for i in ${ip_list}; do
            printf 'next:%s\n' "${i%.*}"
        done >> "$3"

        for v in ${veth_list}; do
            ip -n "$1" link delete "$v"
        done

        ip netns delete "$1"
    fi
}

peer(){
    free "$1" "peer" "$3"
    free "$2" "peer" "$3"
}

bridge(){
    echo "not implemented yet"
}

declare -A cmd=(["peer"]="peer" ["bridge"]="bridge")

while read -r line; do
    if [ ! -z "${cmd[${line%% *}]}" ]; then
        $line "${0%/*/*}/config/network.cfg"
    fi
done < "$1"

if [ ! -z "${cmd[${line%% *}]}" ]; then
    $line "${0%/*/*}/config/network.cfg"
fi