#!/bin/bash

set -eo pipefail

peer(){
    if [ -e "/var/run/netns/$1" ]; then
        ip netns delete "$1"
    fi

    if [ -e "/var/run/netns/$2" ]; then
        ip netns delete "$2"
    fi
}

bridge(){
    if [ -e "/var/run/netns/$1" ]; then
        ip netns delete "$1"
    fi

    if [ -e "/var/run/netns/$2" ]; then
        ip netns delete "$2"
    fi
}

declare -A cmd=(["peer"]="peer" ["bridge"]="bridge")

{
    read -r next_subnet
    while read -r line; do
        if [ ! -z "$line" ] && [ ! -z "${cmd[${line%% *}]}" ]; then
            $line
        fi
    done
} < "$1"

if [ ! -z "$line" ] && [ ! -z "${cmd[${line%% *}]}" ]; then
    $line
fi