#!/bin/bash

set -eo pipefail

netilus_help(){
	echo "Use: netilus <command> <argument>:"
	echo "     netilus {up | down | test } <topology file>"
	echo "     netilus shell <device>"
	echo "     netilus status"
}

wrong_use(){
	echo "Wrong use, try netilus help"
	exit 1
}

if [ "$1" = "help" ]; then
	netilus_help
	exit 0
fi

if [ "$1" = "up" ] || [ "$1" = "down" ]; then

	if [ -z "$2" ]; 
		then wrong_use; 
	fi

    if [ ! -z $NETILUS ]; then 
		cmd="$(echo $NETILUS/lib/$1 | tr -s /)"
    elif [ ! -z "$0" ]; then 
		cmd="$(echo $(dirname $(readlink -f $0))/lib/$1 | tr -s /)"
    else 
		echo "Error: \$0 doesn't exist :("
	fi

	if [ "${2:0:1}" = "/" ]; then
		config="$2"
	else
		config=$(readlink -f "$(echo $(pwd)/$2 | tr -s /)")
	fi

	exec "$cmd" "$config"
fi