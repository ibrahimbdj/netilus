#!/bin/bash

set -eo pipefail

netilus_help(){
	echo "Command use:"
	echo "  netilus <command> <argument>:"
	echo "  netilus {up | down} <topology file>"
	echo "  netilus shell <device>"
	echo "  netilus status"
	echo ""
	echo "Topology file syntax:"
	echo "  peer a b -> link host a to host b"
	echo "  bridge a b -> plug host b into switch a"
	echo "  bridge a b -b -> link switch a to switch b"
	echo "  router a b -> link router a to host b"
	echo "  router a b -b -> link router a to switch b"
	echo "  router a b -r -> link router a to router b"
}

wrong_use(){
	echo "Wrong use, try netilus help" >&2
	exit 1
}

if [ "$1" = "help" ]; then
	netilus_help
	exit 0
fi

if [ "$1" = "up" ] || [ "$1" = "down" ]; then

	if [ -z "$2" ]; 
		then wrong_use; 
	fi

    if [ ! -z $NETILUS ]; then 
		cmd="$(echo $NETILUS/lib/$1 | tr -s /)"
    elif [ ! -z "$0" ]; then 
		cmd="$(echo $(dirname $(readlink -f $0))/lib/$1 | tr -s /)"
    else 
		echo "Error: $0 not found :(" >&2
		exit 1
	fi

	if [ "${2:0:1}" = "/" ]; then
		config="$2"
	else
		config=$(readlink -f "$(echo $(pwd)/$2 | tr -s /)")
	fi

	if [ ! -e "$config" ]; then
		echo "Topology file not found" >&2
		exit 1
	fi

	exec "$cmd" "$config"
fi

wrong_use